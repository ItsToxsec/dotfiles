#!/usr/bin/env bash
set -u
cmd="${1:-}"; shift || true
BAT=/sys/class/power_supply/BAT1
# NixOS does not guarantee that system packages are on Quickshell's PATH.
# Prefer the system profile, then user profiles, then normal PATH.
resolve_bin() {
  local name="$1" p
  for p in \
    "/run/current-system/sw/bin/$name" \
    "/nix/var/nix/profiles/system/sw/bin/$name" \
    "/etc/profiles/per-user/${USER:-}/bin/$name" \
    "$HOME/.nix-profile/bin/$name"; do
    if [[ -x "$p" ]]; then printf '%s\n' "$p"; return 0; fi
  done
  command -v "$name" 2>/dev/null || return 1
}
notify() { local n; n=$(resolve_bin notify-send || true); [[ -n "$n" ]] && "$n" "$@" || true; }
case "$cmd" in
  battery-status)
    if [[ ! -r "$BAT/capacity" ]]; then
      echo 'percentage\t-1%'
      echo 'fraction\t0'
      echo 'status\tUnknown'
      exit 0
    fi
    cap=$(cat "$BAT/capacity" 2>/dev/null || echo -1)
    status=$(cat "$BAT/status" 2>/dev/null || echo Unknown)
    printf 'percentage\t%s%%\nfraction\t%.4f\nstatus\t%s\n' "$cap" "$(awk -v c="$cap" 'BEGIN{print c/100}')" "$status"
    if [[ -r "$BAT/energy_full" ]]; then
      ef=$(cat "$BAT/energy_full"); printf 'size\t%.2f Wh\n' "$(awk -v x="$ef" 'BEGIN{print x/1000000}')"
    elif [[ -r "$BAT/charge_full" ]]; then
      cf=$(cat "$BAT/charge_full"); printf 'size\t%.2f Ah\n' "$(awk -v x="$cf" 'BEGIN{print x/1000000}')"
    fi
    ;;
  battery-low) notify "Battery low" "Battery at ${1:-unknown}%" ;;
  notification-send) notify "$@" ;;
  powerprofiles-list)
    pp=$(resolve_bin powerprofilesctl || true)
    if [[ -z "$pp" ]]; then
      echo "powerprofilesctl not found in PATH or NixOS profiles" >&2
      exit 1
    fi
    active=$("$pp" get 2>/dev/null || true)
    # powerprofilesctl output has one profile heading per line. Handle both
    # current and older formats, including '*' marking the active profile.
    # Only expose the three standard user-selectable power profiles.
    # Do not treat indented metadata fields such as Driver:, PlatformDriver:,
    # or Degraded: as profiles.
    "$pp" list 2>/dev/null | awk -v active="$active" '
      {
        line=$0
        sub(/^[[:space:]]*\*[[:space:]]*/, "", line)
        sub(/^[[:space:]]+/, "", line)
        sub(/[[:space:]]*:.*/, "", line)
        if (line == "power-saver" || line == "balanced" || line == "performance") {
          if (!seen[line]++) printf "%s\t%s\n", line, (line == active ? 1 : 0)
        }
      }
    '
    ;;
  powerprofiles-set)
    pp=$(resolve_bin powerprofilesctl || true)
    if [[ -z "$pp" ]]; then
      echo "powerprofilesctl not found in PATH or NixOS profiles" >&2
      exit 1
    fi
    [[ $# -ge 1 ]] || { echo "usage: omarchy-powerprofiles-set [battery|ac] <profile>" >&2; exit 2; }
    profile="${!#}"
    case "$profile" in
      performance|balanced|power-saver) ;;
      *) echo "unsupported power profile: $profile" >&2; exit 2 ;;
    esac
    exec "$pp" set "$profile"
    ;;
  power-action)
    action="${1:-}"
    case "$action" in
      lock) loginctl lock-session ;;
      logout) loginctl terminate-user "$USER" ;;
      suspend) systemctl suspend ;;
      hibernate) systemctl hibernate ;;
      suspend-then-hibernate) systemctl suspend-then-hibernate ;;
      hybrid-sleep) systemctl hybrid-sleep ;;
      reboot) systemctl reboot ;;
      poweroff|shutdown) systemctl poweroff ;;
      *) echo "unknown power action: $action" >&2; exit 2 ;;
    esac
    ;;
  system-stats)
    awk '/MemTotal:/{t=$2}/MemAvailable:/{a=$2} END{printf "memory\t%.0f%%\n", (1-a/t)*100}' /proc/meminfo
    ;;
  *)
    # Preserve the existing NixOS compatibility implementation for other
    # Omarchy helper commands by dispatching to the original script when this
    # file is replaced in-place.
    echo "unsupported command: $cmd" >&2
    exit 2
    ;;
esac
