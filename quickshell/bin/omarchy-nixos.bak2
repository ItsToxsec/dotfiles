#!/usr/bin/env bash
set -u
cmd="${1:-}"; shift || true
BAT=/sys/class/power_supply/BAT1
notify() { command -v notify-send >/dev/null && notify-send "$@" || true; }
case "$cmd" in
  battery-status)
    if [[ ! -r "$BAT/capacity" ]]; then
      echo 'percentage\t-1%'
      echo 'fraction\t0'
      echo 'status\tUnknown'
      exit 0
    fi
    cap=$(cat "$BAT/capacity" 2>/dev/null || echo -1)
    status=$(cat "$BAT/status" 2>/dev/null || echo Unknown)
    printf 'percentage\t%s%%\nfraction\t%.4f\nstatus\t%s\n' "$cap" "$(awk -v c="$cap" 'BEGIN{print c/100}')" "$status"
    if [[ -r "$BAT/energy_full" ]]; then
      ef=$(cat "$BAT/energy_full"); printf 'size\t%.2f Wh\n' "$(awk -v x="$ef" 'BEGIN{print x/1000000}')"
    elif [[ -r "$BAT/charge_full" ]]; then
      cf=$(cat "$BAT/charge_full"); printf 'size\t%.2f Ah\n' "$(awk -v x="$cf" 'BEGIN{print x/1000000}')"
    fi
    ;;
  battery-low) notify "Battery low" "Battery at ${1:-unknown}%" ;;
  notification-send) notify "$@" ;;
  powerprofiles-list)
    # NixOS: power-profiles-daemon provides powerprofilesctl. Parse its
    # human-readable output without relying on GNU-sed extensions.
    if command -v powerprofilesctl >/dev/null 2>&1; then
      active=$(powerprofilesctl get 2>/dev/null || true)
      powerprofilesctl list 2>/dev/null | awk -v active="$active" '
        /^[[:space:]]*\*?[[:alnum:]][[:alnum:]-]*:/ {
          line=$0
          sub(/^[[:space:]]*\*?/, "", line)
          sub(/:.*/, "", line)
          if (line != "") printf "%s\t%s\n", line, (line == active ? 1 : 0)
        }
      '
    else
      # Keep the panel useful even before power-profiles-daemon is enabled.
      # The profile buttons will report unavailable when activated below.
      printf 'balanced\t1\n'
    fi
    ;;
  powerprofiles-set)
    profile="${2:-balanced}"
    if command -v powerprofilesctl >/dev/null 2>&1; then
      exec powerprofilesctl set "$profile"
    fi
    echo "powerprofilesctl is not installed or power-profiles-daemon is disabled" >&2
    exit 1
    ;;
  power-action)
    action="${1:-}"
    case "$action" in
      lock)
        if command -v swaylock >/dev/null 2>&1; then exec swaylock; fi
        if command -v loginctl >/dev/null 2>&1; then exec loginctl lock-session; fi
        ;;
      logout)
        if command -v loginctl >/dev/null 2>&1; then exec loginctl terminate-user "$USER"; fi
        ;;
      suspend) exec systemctl suspend ;;
      hibernate) exec systemctl hibernate ;;
      suspend-then-hibernate) exec systemctl suspend-then-hibernate ;;
      hybrid-sleep) exec systemctl hybrid-sleep ;;
      reboot) exec systemctl reboot ;;
      poweroff|shutdown) exec systemctl poweroff ;;
      *) echo "unknown power action: $action" >&2; exit 2 ;;
    esac
    exit 1
    ;;
  system-stats)
    awk '/MemTotal:/{t=$2}/MemAvailable:/{a=$2} END{printf "memory\t%.0f%%\n", (1-a/t)*100}' /proc/meminfo
    ;;
  clipboard-paste-text) shift || true; command -v wtype >/dev/null && wtype "$(wl-paste 2>/dev/null)" || true ;;
  clipboard-paste-file) shift || true; command -v wl-paste >/dev/null && wl-paste --type text 2>/dev/null | xargs -0 -r -n1 true || true ;;
  clipboard-open) command -v cliphist >/dev/null && cliphist list | wofi --dmenu | cliphist decode | wl-copy || true ;;
  menu-emoji-insert) command -v wtype >/dev/null && wtype "${1:-}" || true ;;
  launch-browser) command -v xdg-open >/dev/null && xdg-open "$1" >/dev/null 2>&1 & ;;
  launch-screensaver) command -v swaylock >/dev/null && swaylock --daemonize >/dev/null 2>&1 || true ;;
  hyprland-focus-app) command -v hyprctl >/dev/null && hyprctl dispatch focuswindow "${1:-}" >/dev/null 2>&1 || true ;;
  bluetooth-power) command -v bluetoothctl >/dev/null && bluetoothctl power "${1:-on}" >/dev/null 2>&1 || true ;;
  bluetooth-device) command -v bluetoothctl >/dev/null && bluetoothctl "$@" >/dev/null 2>&1 || true ;;
  toggle-nightlight) command -v hyprshade >/dev/null && hyprshade "$@" || true ;;
  *) exit 0 ;;
esac
