{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 600
  },
  "bar": {
    "id": "omarchy.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm"
        }
      ],
      "right": [
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "omarchy.power-controls"
        }
      ]
    }
  },
  "plugins": []
}
